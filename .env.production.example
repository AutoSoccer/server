# Exemplo de variaveis de ambiente para producao (Render + MySQL externo).
# Nao commitar valores reais. Copiar para o painel do Render e preencher os valores
# sensiveis manualmente.

NODE_ENV=production

# Render injeta PORT automaticamente. APP_HOST garante bind em 0.0.0.0.
APP_HOST=0.0.0.0

# Connection string completa do MySQL externo (Railway/Aiven/Clever Cloud).
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=mysql://user:password@host:3306/auto_soccer

# Habilita SSL para o MySQL gerenciado (Railway/Aiven exigem SSL).
DB_SSL=true

# Origem permitida pelo CORS (URL publica do frontend em producao).
# Aceita lista separada por virgulas para multiplos ambientes.
CORS_ORIGIN=https://autosoccer.vercel.app

# Segredo do JWT. Gerar com: openssl rand -hex 32
JWT_SECRET=trocar_por_segredo_forte_gerado_com_openssl
JWT_EXPIRES_IN=5d
